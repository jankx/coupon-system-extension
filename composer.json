{
    "name": "jankx/coupon-system",
    "description": "Coupon system for the nibitour site",
    "type": "wordpress-extension",
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Jankx\\Extensions\\CouponSystem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jankx\\Extensions\\CouponSystem\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Puleeno Nguyen",
            "email": "puleeno@gmail.com"
        }
    ],
    "require": {},
    "config": {
        "vendor-dir": "libs",
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
